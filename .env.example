APP_ENV=development
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=agente_documentacion_probatoria
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
STORAGE_PATH=storage
MAX_UPLOAD_SIZE_MB=10
# Inteligencia artificial (Gemini). Llave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODELOS_RESPALDO=gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_TIMEOUT_SEGUNDOS=60
IA_ANALISIS_AUTOMATICO=true
